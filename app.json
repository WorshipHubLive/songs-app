{
  "expo": {
    "name": "WorshipHub Songs",
    "slug": "songs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/WorshipHub_Songs_Icon.png",
    "scheme": "songsapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#06080f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fercho34.songs-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fercho34.songsapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/WorshipHub_Songs_Icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/WorshipHub_Songs_Icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06080f"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "WorshipHub Songs necesita la cámara para escanear códigos QR de sincronización.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WorshipHub Songs necesita acceso a tus fotos para elegir tu avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "WorshipHub Songs",
    "slug": "worshiphub_songs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/WorshipHub_Songs_Icon.png",
    "scheme": "worshiphub-songs",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#06080f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "live.worshiphub.songs",
      "infoPlist": {
        "NSBonjourServices": ["_worshiphub._tcp.", "_whsongs._tcp."],
        "NSLocalNetworkUsageDescription": "WorshipHub Songs necesita acceso a la red local para encontrar automáticamente WorshipHub y otras copias de la app en tu red."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fercho34.songsapp",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/WorshipHub_Songs_Icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/WorshipHub_Songs_Icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06080f"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "WorshipHub Songs necesita la cámara para escanear códigos QR de sincronización.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WorshipHub Songs necesita acceso a tus fotos para elegir tu avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withInsecureWorshipHubClient",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b1f571aa-f157-4ed0-80ed-ac7869062f57"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b1f571aa-f157-4ed0-80ed-ac7869062f57"
    }
  }
}

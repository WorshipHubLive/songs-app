{
  "expo": {
    "name": "WorshipHub Songs",
    "slug": "songs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/WorshipHub_Songs_Icon.png",
    "scheme": "songsapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#06080f",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/WorshipHub_Songs_Icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/WorshipHub_Songs_Icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06080f"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
